{
  "name": "web-honeypot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n hp,web -c cyan,magenta \"npm:dev:honeypot\" \"npm:dev:web\"",
    "dev:web": "next dev",
    "dev:honeypot": "tsx watch honeypot/server.ts",
    "build": "next build",
    "start": "next start",
    "start:honeypot": "tsx honeypot/server.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "testdata": "tsx scripts/generate-test-data.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "supertest": "^7.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
