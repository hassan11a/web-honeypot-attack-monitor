# --- syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS base

ENV NODE_ENV=production
WORKDIR /app

RUN groupadd --system --gid 1001 honeypot \
  && useradd --system --uid 1001 --gid honeypot --home /app honeypot

FROM base AS deps
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

FROM base AS runtime
COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY tsconfig.json ./
COPY types ./types
COPY lib ./lib
COPY database ./database
COPY honeypot ./honeypot
COPY reports ./reports

ENV HONEYPOT_PORT=8080 \
    SQLITE_FILE=/data/honeypot.db \
    DB_CLIENT=sqlite \
    MAX_REQUEST_BODY_BYTES=65536 \
    REQUEST_TIMEOUT_MS=15000 \
    TRUST_PROXY=1 \
    LOG_LEVEL=info

RUN mkdir -p /data && chown -R honeypot:honeypot /app /data
USER honeypot

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.HONEYPOT_PORT||8080)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["npx", "tsx", "honeypot/server.ts"]
