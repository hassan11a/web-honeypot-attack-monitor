# --- syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS base

ENV NODE_ENV=production
WORKDIR /app

RUN groupadd --system --gid 1001 honeypot \
  && useradd --system --uid 1001 --gid honeypot --home /app honeypot

FROM base AS deps
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npx next build

FROM base AS runtime
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/lib ./lib
COPY --from=build /app/types ./types
COPY --from=build /app/database ./database
COPY --from=build /app/honeypot ./honeypot
COPY --from=build /app/reports ./reports
COPY --from=build /app/components ./components
COPY --from=build /app/app ./app
COPY --from=build /app/next.config.ts ./
COPY --from=build /app/tsconfig.json ./
COPY --from=build /app/proxy.ts ./

ENV NEXT_TELEMETRY_DISABLED=1 \
    SQLITE_FILE=/data/honeypot.db \
    DB_CLIENT=sqlite \
    TRUST_PROXY=1 \
    NEXT_PUBLIC_BASE_PATH=/soc \
    SECURE_COOKIES=0

RUN chown -R honeypot:honeypot /app
USER honeypot

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/soc/login').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["npx", "next", "start"]
