# Application
NODE_ENV=development
LOG_LEVEL=info

# Database — sqlite (default) or postgres
DB_CLIENT=sqlite
SQLITE_FILE=./data/honeypot.db
# DATABASE_URL=postgresql://user:password@localhost:5432/honeypot

# Honeypot service
HONEYPOT_PORT=8080
TRUST_PROXY=1
MAX_REQUEST_BODY_BYTES=65536
MAX_QUERY_LENGTH=2048
REQUEST_TIMEOUT_MS=15000

# Dashboard (Next.js)
PORT=3000
# NEXT_PUBLIC_BASE_PATH=/soc
DASHBOARD_USER=admin
# Use a long random password. Prefer generating a scrypt hash for production.
DASHBOARD_PASSWORD=LocalDev-Passw0rd!2026
SESSION_COOKIE_NAME=hp_session
SESSION_TTL_HOURS=12
# Set to 1 when serving the dashboard over HTTPS
SECURE_COOKIES=0

# Rate limiting / alerts (also adjustable in Settings UI)
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DELAY_MS=0
AUTH_ATTEMPT_THRESHOLD=5
SENSITIVE_PATH_THRESHOLD=10
REQUESTS_PER_MINUTE_ALERT=300
SCANNER_WINDOW_MINUTES=10

# Dev-only test data generator (ignored in production)
ENABLE_TEST_DATA=0

# Docker Compose PostgreSQL profile
POSTGRES_PASSWORD=honeypot
